<Layouts.app flash={@flash} current_scope={@current_scope}>
  <!-- Hero -->
  <section class="py-20 lg:py-28 hero-gradient relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] mb-6 text-base-content">
          Wyszukiwarka przetargów i&nbsp;orzeczeń KIO
        </h1>
        <p class="text-lg sm:text-xl text-base-content/70 mb-12 leading-relaxed max-w-2xl mx-auto">
          Wygrywaj przetargi dzięki danym i automatyzacji: aktualne przetargi publiczne z BZP, orzecznictwo Krajowej Izby Odwoławczej z wyszukiwarką AI, analiza rynku i automatyczne wypełnianie dokumentacji ofertowej — w jednym narzędziu.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={~p"/przetargi"} class="btn-gold px-6 py-3 rounded-lg font-semibold">
            Przeglądaj przetargi
          </a>
          <a href={~p"/orzecznictwo-kio"} class="btn-outline px-6 py-3 rounded-lg font-semibold">
            Szukaj orzeczeń
          </a>
        </div>
      </div>
    </div>
  </section>
  
<!-- Features -->
  <section class="py-20 lg:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-base-content mb-3">
          Co oferujemy?
        </h2>
        <p class="text-base-content/60 max-w-xl mx-auto">
          Kompleksowe narzędzia dla uczestników rynku zamówień publicznych
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <!-- Feature 1: Przetargi -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-document-magnifying-glass" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">Wyszukiwarka przetargów</h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Przeszukuj aktualne ogłoszenia z Biuletynu Zamówień Publicznych.
            Filtruj po regionie, rodzaju zamówienia i słowach kluczowych.
          </p>
          <a
            href={~p"/przetargi"}
            class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
          >
            Przeglądaj przetargi <.icon name="hero-arrow-right" class="size-4" />
          </a>
        </div>
        
<!-- Feature 2: Orzecznictwo -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-scale" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">Orzecznictwo KIO</h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Przeszukuj orzeczenia Krajowej Izby Odwoławczej, Sądów Okręgowych, Apelacyjnych i Sądu Najwyższego.
            Znajdź precedensy do swojej sprawy.
          </p>
          <a
            href={~p"/orzecznictwo-kio"}
            class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
          >
            Szukaj orzeczeń <.icon name="hero-arrow-right" class="size-4" />
          </a>
        </div>
        
<!-- Feature 3: Alerty -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-bell-alert" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">Alerty przetargowe</h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Otrzymuj codzienne powiadomienia o nowych przetargach pasujących do Twoich kryteriów.
            Nigdy nie przegap interesującego zamówienia.
          </p>
          <%= if @current_scope do %>
            <a
              href={~p"/alerty"}
              class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
            >
              Zarządzaj alertami <.icon name="hero-arrow-right" class="size-4" />
            </a>
          <% else %>
            <a
              href={~p"/rejestracja"}
              class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
            >
              Załóż konto <.icon name="hero-arrow-right" class="size-4" />
            </a>
          <% end %>
        </div>
        
<!-- Feature 4: Lista obserwowanych -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-star" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">Lista obserwowanych</h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Zapisuj interesujące przetargi i otrzymuj przypomnienia o zbliżających się terminach składania ofert.
          </p>
          <%= if @current_scope do %>
            <a
              href={~p"/obserwowane"}
              class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
            >
              Zobacz obserwowane <.icon name="hero-arrow-right" class="size-4" />
            </a>
          <% else %>
            <a
              href={~p"/rejestracja"}
              class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
            >
              Załóż konto <.icon name="hero-arrow-right" class="size-4" />
            </a>
          <% end %>
        </div>
        
<!-- Feature 4: Raporty -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-chart-bar" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">Raporty rynkowe</h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Comiesięczne analizy rynku zamówień publicznych z podziałem na regiony i kategorie.
            Śledź trendy i planuj strategię.
          </p>
          <a
            href={~p"/raporty"}
            class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
          >
            Zobacz raporty <.icon name="hero-arrow-right" class="size-4" />
          </a>
        </div>
        
<!-- Feature 5: Automatyczne wypełnianie dokumentów -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-document-check" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">
            Automatyczne wypełnianie dokumentów
          </h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Wypełniaj dokumentację ofertową automatycznie na podstawie danych z profilu firmy.
            Oszczędź godziny pracy przy każdym przetargu.
          </p>
          <a
            href={~p"/przetargi"}
            class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
          >
            Zobacz przetargi <.icon name="hero-arrow-right" class="size-4" />
          </a>
        </div>
        
<!-- Feature 6: Analiza konkurencji -->
        <div class="pricing-card p-6">
          <div class="w-10 h-10 mb-5 rounded-lg bg-primary/10 flex items-center justify-center">
            <.icon name="hero-user-group" class="size-5 text-primary" />
          </div>
          <h3 class="text-base font-semibold text-base-content mb-2">Analiza konkurencji</h3>
          <p class="text-sm text-base-content/60 leading-relaxed">
            Sprawdź kto wygrywał podobne przetargi, za ile i w jakim regionie.
            Podejmuj decyzje o starcie na podstawie danych, nie intuicji.
          </p>
          <a
            href={~p"/analiza-rynku"}
            class="inline-flex items-center gap-1 text-primary hover:underline mt-4 text-sm font-medium"
          >
            Analizuj rynek <.icon name="hero-arrow-right" class="size-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
  <%!-- Entry points into both sections: the hubs people actually search for --%>
  <section class="py-16 bg-base-200" id="home-hubs">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <.hub_grid
        id="home-kio-topics"
        title="Orzecznictwo KIO według zagadnień"
        lead="Linia orzecznicza Krajowej Izby Odwoławczej dla najczęstszych sporów w zamówieniach publicznych — z omówieniem, podstawą prawną i statystyką rozstrzygnięć."
        items={
          Enum.map(
            Enum.take(Przetargowi.Judgements.Topics.all(), 6),
            &%{path: Przetargowi.Judgements.Topics.path(&1), name: &1.name, lead: &1.lead}
          )
        }
      />
      <p class="-mt-8 mb-14">
        <a href={~p"/orzecznictwo-kio"} class="text-primary font-medium hover:underline">
          Wszystkie zagadnienia i wyszukiwarka orzeczeń KIO →
        </a>
        <span class="text-base-content/40 mx-2">·</span>
        <a
          href={~p"/orzecznictwo-kio/statystyki"}
          class="text-primary font-medium hover:underline"
        >
          Statystyki KIO
        </a>
      </p>

      <.hub_grid
        id="home-tender-categories"
        title="Przetargi publiczne według branży"
        lead="Aktualne ogłoszenia z Biuletynu Zamówień Publicznych z terminami składania ofert."
        items={
          Enum.map(
            Enum.take(Przetargowi.Tenders.Hubs.category_hubs(), 6),
            &%{path: "/przetargi/branza/#{&1.slug}", name: &1.h1, lead: &1.intro}
          )
        }
      />
      <p class="-mt-8">
        <a href={~p"/przetargi"} class="text-primary font-medium hover:underline">
          Wszystkie branże, województwa i wyszukiwarka przetargów →
        </a>
      </p>
    </div>
  </section>
</Layouts.app>
