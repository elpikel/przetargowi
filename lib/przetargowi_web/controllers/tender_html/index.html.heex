<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="hero-backdrop bg-base-200 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <.hub_header
        crumbs={[{"Strona główna", "/"}, {"Przetargi", "/przetargi"}, {"Wyszukiwarka", nil}]}
        title={assigns[:hub_title] || "Wyszukiwarka przetargów"}
        lead={
          assigns[:hub_intro] ||
            "Filtruj aktualne ogłoszenia z Biuletynu Zamówień Publicznych po słowach kluczowych, województwie, rodzaju zamówienia i terminie składania ofert."
        }
      />
      
<!-- Search Form -->
      <form action={~p"/przetargi"} method="get" class="card-base p-6 mb-8">
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <!-- Keyword Search -->
          <div class="lg:col-span-2">
            <label class="block text-sm font-medium text-base-content/70 mb-2">Szukaj</label>
            <input
              type="text"
              name="q"
              value={@query}
              placeholder="Słowa kluczowe..."
              class="search-input w-full px-4 py-3 rounded-lg"
            />
          </div>
          
<!-- Region Filter Dropdown -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">Województwo</label>
            <details class="dropdown-filter relative">
              <summary class="search-input w-full px-4 py-3 rounded-lg cursor-pointer flex items-center justify-between list-none">
                <span class="truncate">
                  <%= if @regions == [] do %>
                    Wszystkie
                  <% else %>
                    {length(@regions)} wybrano
                  <% end %>
                </span>
                <.icon name="hero-chevron-down" class="size-4 text-base-content/50 flex-shrink-0" />
              </summary>
              <div class="absolute z-50 mt-1 w-full bg-base-200 border border-base-300 rounded-lg shadow-xl max-h-64 overflow-y-auto">
                <div class="p-2 border-b border-base-300">
                  <label class="flex items-center gap-2 px-2 py-1 cursor-pointer hover:bg-base-300/50 rounded text-sm">
                    <input
                      type="checkbox"
                      class="checkbox checkbox-sm checkbox-primary"
                      onchange="toggleAllCheckboxes(this, 'region-checkbox')"
                      checked={@regions == []}
                    />
                    <span class="font-medium text-base-content">Wszystkie</span>
                  </label>
                </div>
                <div class="p-2 space-y-1">
                  <%= for {value, label} <- region_options() do %>
                    <label class="flex items-center gap-2 px-2 py-1 cursor-pointer hover:bg-base-300/50 rounded text-sm">
                      <input
                        type="checkbox"
                        name="regions[]"
                        value={value}
                        checked={value in @regions}
                        class="checkbox checkbox-sm checkbox-primary region-checkbox"
                      />
                      <span class="text-base-content">{label}</span>
                    </label>
                  <% end %>
                </div>
              </div>
            </details>
          </div>
          
<!-- Order Type Filter Dropdown -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Rodzaj zamówienia
            </label>
            <details class="dropdown-filter relative">
              <summary class="search-input w-full px-4 py-3 rounded-lg cursor-pointer flex items-center justify-between list-none">
                <span class="truncate">
                  <%= if @order_types == [] do %>
                    Wszystkie
                  <% else %>
                    {Enum.map_join(@order_types, ", ", &format_order_type/1)}
                  <% end %>
                </span>
                <.icon name="hero-chevron-down" class="size-4 text-base-content/50 flex-shrink-0" />
              </summary>
              <div class="absolute z-50 mt-1 w-full bg-base-200 border border-base-300 rounded-lg shadow-xl">
                <div class="p-2 border-b border-base-300">
                  <label class="flex items-center gap-2 px-2 py-1 cursor-pointer hover:bg-base-300/50 rounded text-sm">
                    <input
                      type="checkbox"
                      class="checkbox checkbox-sm checkbox-primary"
                      onchange="toggleAllCheckboxes(this, 'order-type-checkbox')"
                      checked={@order_types == []}
                    />
                    <span class="font-medium text-base-content">Wszystkie</span>
                  </label>
                </div>
                <div class="p-2 space-y-1">
                  <%= for {value, label} <- order_type_options() do %>
                    <label class="flex items-center gap-2 px-2 py-1 cursor-pointer hover:bg-base-300/50 rounded text-sm">
                      <input
                        type="checkbox"
                        name="order_types[]"
                        value={value}
                        checked={value in @order_types}
                        class="checkbox checkbox-sm checkbox-primary order-type-checkbox"
                      />
                      <span class="text-base-content">{label}</span>
                    </label>
                  <% end %>
                </div>
              </div>
            </details>
          </div>
        </div>
        
<!-- Winner Analysis Toggle & Deadline Date Filters -->
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mt-4">
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Termin od
            </label>
            <input
              type="date"
              name="deadline_from"
              value={@deadline_from}
              class="search-input w-full px-4 py-3 rounded-lg"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Termin do
            </label>
            <input
              type="date"
              name="deadline_to"
              value={@deadline_to}
              class="search-input w-full px-4 py-3 rounded-lg"
            />
          </div>
          <div class="lg:col-span-2 flex items-end">
            <label class="flex items-center gap-3 cursor-pointer px-4 py-3">
              <input
                type="checkbox"
                name="with_winner_analysis"
                value="1"
                checked={@with_winner_analysis}
                class="checkbox checkbox-sm checkbox-primary"
              />
              <span class="text-sm font-medium text-base-content/70">
                <.icon name="hero-trophy" class="size-4 text-secondary inline-block mr-1" />
                Tylko z analizą „Kto wygrywa?"
              </span>
            </label>
          </div>
        </div>

        <div class="mt-4 flex justify-end">
          <div class="flex gap-3">
            <%= if @query != "" or @regions != [] or @order_types != [] or @deadline_from != "" or @deadline_to != "" or @with_winner_analysis do %>
              <a href={~p"/przetargi"} class="btn-outline px-4 py-2 rounded-lg text-sm">
                Wyczyść filtry
              </a>
            <% end %>
            <button type="submit" class="btn-gold px-6 py-2 rounded-lg text-sm font-medium">
              Szukaj
            </button>
          </div>
        </div>
      </form>
      
<!-- Results Count -->
      <div class="mb-6 flex items-center justify-between">
        <p class="text-base-content/60">
          Znaleziono <span class="font-semibold text-base-content">{@total_count}</span>
          przetargów
        </p>
        <%= if @can_create_alert && (@regions != [] or @order_types != []) do %>
          <form action={~p"/alerty"} method="post" class="inline">
            <input type="hidden" name="_csrf_token" value={Phoenix.Controller.get_csrf_token()} />
            <%= for region <- @regions do %>
              <input type="hidden" name="alert[regions][]" value={region} />
            <% end %>
            <%= for order_type <- @order_types do %>
              <input type="hidden" name="alert[order_types][]" value={order_type} />
            <% end %>
            <button
              type="submit"
              class="btn-outline px-4 py-2 rounded-lg text-sm flex items-center gap-2"
            >
              <.icon name="hero-bell" class="size-4" /> Utwórz alert
            </button>
          </form>
        <% end %>
      </div>
      
<!-- Results -->
      <%= if @notices == [] do %>
        <.empty_results
          title="Brak wyników dla podanych kryteriów"
          hint="Spróbuj zmienić filtry lub słowa kluczowe"
        />
      <% else %>
        <div class="space-y-4" id="tender-results">
          <.tender_card
            :for={notice <- @notices}
            notice={notice}
            current_scope={@current_scope}
            watched_ids={@watched_ids}
          />
        </div>
      <% end %>

      <.pager
        id="tender-pagination"
        page={@page}
        total_pages={@total_pages}
        nofollow
        path={
          fn page ->
            ~p"/przetargi?#{build_pagination_params(@query, @regions, @order_types, @deadline_from, @deadline_to, @with_winner_analysis, page)}"
          end
        }
      />

      <.link_columns id="tender-browse" title="Przeglądaj przetargi" columns={browse_columns()} />
    </div>

    <script>
      // Close dropdown when clicking outside
      document.addEventListener('click', function(e) {
        document.querySelectorAll('details.dropdown-filter[open]').forEach(function(dropdown) {
          if (!dropdown.contains(e.target)) {
            dropdown.removeAttribute('open');
          }
        });
      });

      // Toggle all checkboxes helper
      function toggleAllCheckboxes(allCheckbox, className) {
        const checkboxes = document.querySelectorAll('.' + className);
        if (allCheckbox.checked) {
          checkboxes.forEach(cb => cb.checked = false);
        }
      }

      // Uncheck "all" when individual items are checked
      document.querySelectorAll('.region-checkbox, .order-type-checkbox').forEach(function(cb) {
        cb.addEventListener('change', function() {
          const parent = this.closest('details');
          const allCheckbox = parent.querySelector('input[type="checkbox"]:not([name])');
          if (this.checked && allCheckbox) {
            allCheckbox.checked = false;
          }
        });
      });
    </script>
  </div>
</Layouts.app>
