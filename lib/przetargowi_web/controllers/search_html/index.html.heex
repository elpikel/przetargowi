<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="hero-backdrop bg-base-200 min-h-screen">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <.hub_header
        crumbs={[
          {"Strona główna", "/"},
          {"Orzecznictwo KIO", "/orzecznictwo-kio"},
          {"Wyszukiwarka", nil}
        ]}
        title="Wyszukiwarka orzeczeń KIO"
        lead="Przeszukuj orzeczenia Krajowej Izby Odwoławczej po słowach kluczowych, sygnaturze i filtrach albo opisz problem własnymi słowami w trybie semantycznym AI."
      />
      
<!-- Search Form -->
      <form
        action="/orzecznictwo-kio/szukaj"
        method="get"
        class="card-base p-6 mb-8"
        id="search-form"
      >
        <!-- Search mode toggle -->
        <div class="mb-4">
          <label class="block text-sm font-medium text-base-content/70 mb-2">
            Tryb wyszukiwania
          </label>
          <div class="inline-flex rounded-lg bg-base-200 p-1">
            <a
              href={"/orzecznictwo-kio/szukaj?mode=keyword" <> if(@query != "", do: "&q=#{URI.encode(@query)}", else: "")}
              rel="nofollow"
              class={"px-4 py-2 rounded-md text-sm font-medium transition-colors " <> if(@search_mode == "keyword", do: "bg-primary text-primary-content", else: "text-base-content/70 hover:text-base-content")}
            >
              <span class="flex items-center gap-2">
                <.icon name="hero-magnifying-glass" class="size-4" /> Słowa kluczowe
              </span>
            </a>
            <a
              href={"/orzecznictwo-kio/szukaj?mode=semantic" <> if(@query != "", do: "&q=#{URI.encode(@query)}", else: "")}
              rel="nofollow"
              class={"px-4 py-2 rounded-md text-sm font-medium transition-colors " <> if(@search_mode == "semantic", do: "bg-secondary text-secondary-content", else: "text-base-content/70 hover:text-base-content")}
            >
              <span class="flex items-center gap-2">
                <.icon name="hero-sparkles" class="size-4" /> Semantyczne (AI)
              </span>
            </a>
          </div>
          <%= if @search_mode == "semantic" do %>
            <p class="text-xs text-base-content/50 mt-2">
              Wyszukuje podobne znaczeniowo orzeczenia (pierwsze wyszukiwanie może potrwać kilka sekund)
            </p>
          <% end %>
        </div>

        <input type="hidden" name="mode" value={@search_mode} />

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          <!-- Search Input -->
          <div class="lg:col-span-2">
            <label class="block text-sm font-medium text-base-content/70 mb-2">Szukaj</label>
            <input
              type="text"
              name="q"
              value={@query}
              placeholder={
                if(@search_mode == "semantic",
                  do: "Opisz czego szukasz własnymi słowami...",
                  else: "Słowa kluczowe..."
                )
              }
              class="search-input w-full px-4 py-3 rounded-lg"
            />
          </div>
          
<!-- Document Type -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Rodzaj dokumentu
            </label>
            <select
              name="document_type"
              class="search-input w-full px-4 py-3 rounded-lg appearance-none"
            >
              <option value="">Wszystkie</option>
              <%= for type <- @filter_options.document_types do %>
                <option value={type} selected={@filters[:document_type] == type}>{type}</option>
              <% end %>
            </select>
          </div>
          
<!-- Issuing Authority -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Organ wydający
            </label>
            <select
              name="issuing_authority"
              class="search-input w-full px-4 py-3 rounded-lg appearance-none"
            >
              <option value="">Wszystkie</option>
              <%= for authority <- @filter_options.issuing_authorities do %>
                <option value={authority} selected={@filters[:issuing_authority] == authority}>
                  {authority}
                </option>
              <% end %>
            </select>
          </div>
        </div>
        
<!-- Second Row of Filters -->
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mt-4">
          <!-- Resolution Method -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Sposób rozstrzygnięcia
            </label>
            <select
              name="resolution_method"
              class="search-input w-full px-4 py-3 rounded-lg appearance-none"
            >
              <option value="">Wszystkie</option>
              <%= for method <- @filter_options.resolution_methods do %>
                <option value={method} selected={@filters[:resolution_method] == method}>
                  {method}
                </option>
              <% end %>
            </select>
          </div>
          
<!-- Procedure Type -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">
              Tryb postępowania
            </label>
            <select
              name="procedure_type"
              class="search-input w-full px-4 py-3 rounded-lg appearance-none"
            >
              <option value="">Wszystkie</option>
              <%= for proc_type <- @filter_options.procedure_types do %>
                <option value={proc_type} selected={@filters[:procedure_type] == proc_type}>
                  {proc_type}
                </option>
              <% end %>
            </select>
          </div>
          
<!-- Date From -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">Data od</label>
            <input
              type="date"
              name="date_from"
              value={@filters[:date_from]}
              class="search-input w-full px-4 py-3 rounded-lg"
            />
          </div>
          
<!-- Date To -->
          <div>
            <label class="block text-sm font-medium text-base-content/70 mb-2">Data do</label>
            <input
              type="date"
              name="date_to"
              value={@filters[:date_to]}
              class="search-input w-full px-4 py-3 rounded-lg"
            />
          </div>
        </div>

        <div class="mt-4 flex justify-end">
          <div class="flex gap-3">
            <%= if has_active_filters?(@filters) do %>
              <a
                href="/orzecznictwo-kio/szukaj"
                class="btn-outline px-4 py-2 rounded-lg text-sm"
                rel="nofollow"
              >
                Wyczyść filtry
              </a>
            <% end %>
            <button
              type="submit"
              id="search-btn"
              class="btn-gold px-6 py-2 rounded-lg text-sm font-medium inline-flex items-center gap-2"
            >
              <span id="search-btn-text">Szukaj</span>
              <svg
                id="search-spinner"
                class="hidden animate-spin size-4"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                >
                </circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                >
                </path>
              </svg>
            </button>
          </div>
        </div>
      </form>

      <script>
        document.getElementById('search-form').addEventListener('submit', function() {
          const mode = document.querySelector('input[name="mode"]').value;
          if (mode === 'semantic') {
            document.getElementById('search-btn-text').textContent = 'Szukam...';
            document.getElementById('search-spinner').classList.remove('hidden');
            document.getElementById('search-btn').disabled = true;
          }
        });
      </script>
      
<!-- Results Count -->
      <div class="mb-6">
        <p class="text-base-content/60">
          <%= if @query != "" do %>
            Znaleziono <span class="font-semibold text-base-content">{@total_count}</span>
            orzeczeń dla „<span class="font-medium">{@query}</span>"
          <% else %>
            <span class="font-semibold text-base-content">{@total_count}</span> orzeczeń w bazie
          <% end %>
        </p>
      </div>
      
<!-- Error States -->
      <%= if @semantic_error do %>
        <div class="card-base p-12 text-center">
          <.icon name="hero-exclamation-triangle" class="size-12 text-error mx-auto mb-4" />
          <p class="text-base-content mb-2">{@semantic_error}</p>
          <p class="text-sm text-base-content/60">Spróbuj wyszukiwania słów kluczowych.</p>
        </div>
      <% end %>
      
<!-- Results -->
      <%= if @results == [] do %>
        <.empty_results
          title="Brak orzeczeń dla podanych kryteriów"
          hint="Spróbuj zmienić filtry lub słowa kluczowe"
        />
      <% else %>
        <div class="space-y-4" id="search-results">
          <PrzetargowiWeb.LandingHTML.ruling_card
            :for={result <- @results}
            judgement={result}
            highlight={if(@search_mode == "semantic", do: Map.get(result, :matched_chunk))}
          />
        </div>
      <% end %>

      <.pager
        id="search-pagination"
        page={@current_page}
        total_pages={@total_pages}
        nofollow
        path={
          fn page ->
            "/orzecznictwo-kio/szukaj?#{pagination_params(@query, @filters, @search_mode, page)}"
          end
        }
      />

      <.link_columns
        id="kio-browse"
        title="Przeglądaj orzecznictwo KIO"
        columns={PrzetargowiWeb.LandingHTML.browse_columns()}
      />
    </div>
  </div>
</Layouts.app>
