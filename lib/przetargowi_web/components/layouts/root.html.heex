<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={
        assigns[:meta_description] ||
          "Przetargowi.pl — wyszukiwarka przetargów publicznych i orzeczeń KIO. Aktualne ogłoszenia o przetargach, wyroki KIO, orzecznictwo zamówień publicznych."
      }
    />
    <meta name="robots" content={assigns[:meta_robots] || "index, follow"} />
    <meta property="og:title" content={assigns[:page_title] || "Przetargowi"} />
    <meta
      property="og:description"
      content={assigns[:meta_description] || "Wyszukiwarka orzeczeń zamówień publicznych."}
    />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta
      property="og:image"
      content={assigns[:og_image] || "https://przetargowi.pl/images/og-default.png"}
    />
    <%= if !assigns[:og_image] do %>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    <% end %>
    <meta property="og:locale" content="pl_PL" />
    <meta
      property="og:url"
      content={assigns[:og_url] || assigns[:canonical_url] || "https://przetargowi.pl"}
    />
    <meta property="og:site_name" content="Przetargowi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:image"
      content={assigns[:og_image] || "https://przetargowi.pl/images/og-default.png"}
    />
    <meta name="twitter:title" content={assigns[:page_title] || "Przetargowi"} />
    <meta
      name="twitter:description"
      content={assigns[:meta_description] || "Wyszukiwarka orzeczeń zamówień publicznych."}
    />
    <%= if assigns[:canonical_url] do %>
      <link rel="canonical" href={@canonical_url} />
    <% end %>
    <link rel="icon" href={~p"/favicon.svg?v=2"} type="image/svg+xml" />
    <link rel="icon" href={~p"/favicon.ico?v=2"} type="image/x-icon" sizes="any" />
    <title>{PrzetargowiWeb.Layouts.document_title(assigns[:page_title])}</title>
    <%!-- Inter is served from our own origin; preloading the two subsets a
         Polish page needs avoids a flash of fallback text. --%>
    <link
      rel="preload"
      href={~p"/fonts/inter-latin.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/inter-latin-ext.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Przetargowi",
        "url": "https://przetargowi.pl",
        "inLanguage": "pl-PL",
        "publisher": {
          "@type": "Organization",
          "name": "Przetargowi.pl",
          "url": "https://przetargowi.pl",
          "logo": "https://przetargowi.pl/favicon.svg"
        },
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://przetargowi.pl/orzecznictwo-kio/szukaj?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      }
    </script>
    <%= if assigns[:breadcrumbs] do %>
      <script type="application/ld+json">
        <%= raw(Jason.encode!(%{
          "@context" => "https://schema.org",
          "@type" => "BreadcrumbList",
          "itemListElement" => Enum.with_index(assigns[:breadcrumbs], 1) |> Enum.map(fn {crumb, pos} ->
            %{
              "@type" => "ListItem",
              "position" => pos,
              "name" => crumb.name,
              "item" => crumb.url
            }
          end)
        })) %>
      </script>
    <% end %>
    <%= if assigns[:article_json_ld] do %>
      <script type="application/ld+json">
        <%= raw(Jason.encode!(@article_json_ld)) %>
      </script>
    <% end %>
    <script defer data-domain="przetargowi.pl" data-api="/api/event" src="/js/stats.js">
    </script>
  </head>
  <body class="bg-base-100 text-base-content">
    {@inner_content}
  </body>
</html>
